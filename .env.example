# ─────────────────────────────────────────────────────────────────────────────
# .env.example — REQUIRED ENVIRONMENT VARIABLES
#
# This file is safe to commit. It documents every environment variable the
# project needs without containing any real secrets.
#
# To set up locally:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in your Supabase project credentials
#   3. Never commit .env.local
#
# Find your Supabase credentials at:
#   https://supabase.com/dashboard → your project → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL — from Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key — from Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — from Settings → API → Project API keys → service_role
# SERVER ONLY. Never expose to the browser. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter API key — from https://openrouter.ai/keys
# SERVER ONLY. Never use NEXT_PUBLIC_OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
